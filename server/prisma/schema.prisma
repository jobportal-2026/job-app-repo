generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  EMPLOYEE
  EMPLOYER
}

enum UserStatus {
  PENDING_PHONE_VERIFICATION
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum JobStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

enum JobModerationStatus {
  CLEAN
  FLAGGED
  REMOVED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  REMOTE
  HYBRID
}

enum ApplicationStatus {
  APPLIED
  UNDER_REVIEW
  SHORTLISTED
  INTERVIEW
  OFFERED
  HIRED
  REJECTED
  WITHDRAWN
}

enum NotificationType {
  APPLICATION_UPDATE
  JOB_ALERT
  SYSTEM
  JOB_MODERATION
}

enum FileType {
  RESUME
  AVATAR
  COMPANY_LOGO
  DOCUMENT
  OTHER
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  PASSWORD_CHANGE
  PHONE_VERIFY
  SUSPEND
}

enum AuthProvider {
  LOCAL
  GOOGLE
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  email           String?    @unique
  phone           String     @unique
  passwordHash    String?
  name            String
  role            UserRole
  status          UserStatus @default(PENDING_PHONE_VERIFICATION)
  phoneVerified   Boolean    @default(false)
  phoneVerifiedAt DateTime?
  lastLoginAt     DateTime?
  deletedAt       DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  employeeProfile EmployeeProfile?
  employerProfile EmployerProfile?
  refreshTokens   RefreshToken[]
  sessions        Session[]
  oauthAccounts   OAuthAccount[]
  notifications   Notification[]
  files           File[]
  auditLogs       AuditLog[]
  reportsFiled    Report[]       @relation("ReportReporter")

  @@index([role, status])
  @@index([deletedAt])
  @@map("users")
}

model Admin {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String
  name         String
  isActive     Boolean   @default(true)
  permissions  String[]
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  refreshTokens AdminRefreshToken[]
  auditLogs     AuditLog[]

  @@map("admins")
}

model OAuthAccount {
  id             String       @id @default(uuid()) @db.Uuid
  provider       AuthProvider
  providerUserId String
  userId         String       @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([provider, providerUserId])
  @@map("oauth_accounts")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model AdminRefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  tokenHash String
  adminId   String    @db.Uuid
  admin     Admin     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([adminId])
  @@map("admin_refresh_tokens")
}

model Session {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  jti       String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@map("sessions")
}

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
  RESEND_LIMIT
}

model OtpVerification {
  id        String     @id @default(uuid()) @db.Uuid
  phone     String
  purpose   OtpPurpose
  codeHash  String
  attempts  Int        @default(0)
  expiresAt DateTime
  createdAt DateTime   @default(now())

  @@unique([phone, purpose])
  @@index([expiresAt])
  @@map("otp_verifications")
}

model RevokedToken {
  jti       String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
  @@map("revoked_tokens")
}

model EmployeeProfile {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline  String?
  summary   String?
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  experiences  Experience[]
  educations   Education[]
  skills       EmployeeSkill[]
  applications Application[]

  @@map("employee_profiles")
}

model EmployerProfile {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @unique @db.Uuid
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  designation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company?

  @@map("employer_profiles")
}

model Company {
  id          String          @id @default(uuid()) @db.Uuid
  employerId  String          @unique @db.Uuid
  employer    EmployerProfile @relation(fields: [employerId], references: [id], onDelete: Cascade)
  name        String
  slug        String          @unique
  description String?
  website     String?
  industry    String?
  size        String?
  logoUrl     String?
  location    String?
  deletedAt   DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  jobs Job[]

  @@index([deletedAt])
  @@map("companies")
}

model Job {
  id               String              @id @default(uuid()) @db.Uuid
  companyId        String              @db.Uuid
  company          Company             @relation(fields: [companyId], references: [id])
  title            String
  slug             String
  description      String
  requirements     String?
  jobType          JobType
  location         String?
  salaryMin        Int?
  salaryMax        Int?
  salaryCurrency   String?             @default("USD")
  status           JobStatus           @default(DRAFT)
  moderationStatus JobModerationStatus @default(CLEAN)
  applicationCount Int                 @default(0)
  publishedAt      DateTime?
  expiresAt        DateTime?
  deletedAt        DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  skills       JobSkill[]
  applications Application[]
  reports      Report[]

  @@unique([companyId, slug])
  @@index([status, publishedAt])
  @@index([moderationStatus])
  @@index([deletedAt])
  @@map("jobs")
}

model Application {
  id                String            @id @default(uuid()) @db.Uuid
  jobId             String            @db.Uuid
  job               Job               @relation(fields: [jobId], references: [id])
  employeeProfileId String            @db.Uuid
  employeeProfile   EmployeeProfile   @relation(fields: [employeeProfileId], references: [id])
  status            ApplicationStatus @default(APPLIED)
  coverLetter       String?
  resumeFileId      String?           @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  statusHistory ApplicationStatusHistory[]

  @@unique([jobId, employeeProfileId])
  @@index([status])
  @@map("applications")
}

model ApplicationStatusHistory {
  id            String             @id @default(uuid()) @db.Uuid
  applicationId String             @db.Uuid
  application   Application        @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String?            @db.Uuid
  note          String?
  createdAt     DateTime           @default(now())

  @@map("application_status_history")
}

model Skill {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique
  slug      String   @unique
  createdAt DateTime @default(now())

  jobSkills      JobSkill[]
  employeeSkills EmployeeSkill[]

  @@map("skills")
}

model JobSkill {
  jobId   String @db.Uuid
  skillId String @db.Uuid
  job     Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  skill   Skill  @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([jobId, skillId])
  @@map("job_skills")
}

model EmployeeSkill {
  employeeProfileId String          @db.Uuid
  skillId           String          @db.Uuid
  proficiency       Int?
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  skill             Skill           @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([employeeProfileId, skillId])
  @@map("employee_skills")
}

model Experience {
  id                String          @id @default(uuid()) @db.Uuid
  employeeProfileId String          @db.Uuid
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  companyName       String
  title             String
  description       String?
  startDate         DateTime
  endDate           DateTime?
  isCurrent         Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("experiences")
}

model Education {
  id                String          @id @default(uuid()) @db.Uuid
  employeeProfileId String          @db.Uuid
  employeeProfile   EmployeeProfile @relation(fields: [employeeProfileId], references: [id], onDelete: Cascade)
  institution       String
  degree            String
  fieldOfStudy      String?
  startDate         DateTime
  endDate           DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@map("educations")
}

model Notification {
  id        String           @id @default(uuid()) @db.Uuid
  userId    String           @db.Uuid
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  data      Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model File {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id])
  type         FileType
  originalName String
  mimeType     String
  size         Int
  s3Key        String   @unique
  s3Bucket     String
  createdAt    DateTime @default(now())

  @@index([userId, type])
  @@map("files")
}

model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  action     AuditAction
  entityType String
  entityId   String?     @db.Uuid
  userId     String?     @db.Uuid
  user       User?       @relation(fields: [userId], references: [id])
  adminId    String?     @db.Uuid
  admin      Admin?      @relation(fields: [adminId], references: [id])
  ipAddress  String?
  userAgent  String?
  metadata   Json?
  createdAt  DateTime    @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([adminId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Report {
  id          String   @id @default(uuid()) @db.Uuid
  reporterId  String   @db.Uuid
  reporter    User     @relation("ReportReporter", fields: [reporterId], references: [id])
  jobId       String?  @db.Uuid
  job         Job?     @relation(fields: [jobId], references: [id])
  reason      String
  description String?
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  @@map("reports")
}

model SystemConfig {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_config")
}
